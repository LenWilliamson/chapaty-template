# Local environment overrides. Loaded via dotenvy in src/main.rs.
# All variables are optional; every one has a safe fallback if left empty/unset.

# Which agent to run: "demo" or "template" (see src/main.rs ActiveAgent).
# Defaults to "demo" if unset or unrecognized.
# ACTIVE_AGENT=

# Number of agents randomly selected from the agent grid search.
# Defaults to 100 if unset or unparseable.
# GRID_SEARCH_LIMIT=

# Cloud bucket for generated reports (journal, leaderboard, etc.).
# If unset, reports are written to the local chapaty/reports/ directory instead.
# RESULTS_CLOUD_URI=gs://chapaty-dev-results

# Bucket-relative prefix for the crash-diagnostic upload (execution_stderr.txt)
# on a panic or fatal error. If unset, crash logs are only printed to stderr,
# not uploaded (see src/crash.rs).
# GCP_CRASH_LOG_PREFIX=prefix
# INTERNAL_BUCKET=chapaty-dev-internal
